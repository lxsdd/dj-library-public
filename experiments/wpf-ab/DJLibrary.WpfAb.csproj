<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DJLibrary.WpfAb</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../shared/SyntheticCatalog.cs" Link="SyntheticCatalog.cs" />
    <Compile Include="../shared/SyntheticSelection.cs" Link="SyntheticSelection.cs" />
    <!-- Exact, unmodified production DJ Library native SQLite-projection model. -->
    <Compile Include="../../src/CatalogNativeModels.cs" Link="Production/CatalogNativeModels.cs" />
    <Compile Include="../shared/NativeTrackProjection.cs" Link="Shared/NativeTrackProjection.cs" />
    <!-- Original production native SQLite API and unchanged CatalogService SQL. -->
    <Compile Include="../../src/WinSqlite.cs" Link="Production/WinSqlite.cs" />
    <Compile Include="../../src/CatalogService.NativeProjection.cs" Link="Production/CatalogService.NativeProjection.cs" />
    <!-- Synthetic disposable SQLite fixture and minimal CatalogService host only. -->
    <Compile Include="../shared/NativeSqliteFixture.cs" Link="Shared/NativeSqliteFixture.cs" />
  </ItemGroup>
</Project>
