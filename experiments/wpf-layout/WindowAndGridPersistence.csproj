<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <StartupObject>Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <!-- Exercise the actual, unchanged production persistence implementation. -->
    <Compile Include="../../src/Settings.cs" Link="Production/Settings.cs" />
    <Compile Include="../../src/WindowGeometrySettings.cs" Link="Production/WindowGeometrySettings.cs" />
    <Compile Include="../../src/GridLayoutSettings.cs" Link="Production/GridLayoutSettings.cs" />
    <!-- Only unrelated external product configuration types are substituted. -->
    <Compile Include="Fixtures.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="CompatibilitySnapshot.cs" />
  </ItemGroup>
</Project>
